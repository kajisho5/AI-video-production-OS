        "ffmpeg",
        "ffprobe",
        "encoder:pcm_s16le",
        "filter:loudnorm"
      ],
      "tool": "ffmpeg-skill/loudness",
      "type": "NORMALIZE"
    },
    {
      "description": "Sum 2..8 inputs; output duration follows the first input (ffmpeg-skill amix duration=first)",
