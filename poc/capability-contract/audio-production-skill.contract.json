  "operations": [
    {
      "description": "Apply a fixed gain in dB",
      "deterministic": "content_equivalent",
      "inputs": {
        "max": 1,
        "min": 1
      },
      "keeps_timeline": true,
      "parameters": {
        "gain_db": {
          "description": "gain in dB (negative attenuates)",
          "max": 60.0,
          "min": -60.0,
          "required": true,
          "type": "number"
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "encoder:pcm_s16le",
        "filter:volume"
      ],
      "tool": "ffmpeg-skill/audio",
      "type": "GAIN"
    },
    {
      "description": "Keep one source time range [start, end)",
      "deterministic": "content_equivalent",
      "inputs": {
        "max": 1,
        "min": 1
      },
      "keeps_timeline": false,
      "parameters": {
        "end": {
          "description": "source time in seconds, > start",
          "max": 86400.0,
          "min": 0.0,
          "required": true,
          "type": "number"
        },
        "start": {
          "description": "source time in seconds",
          "max": 86400.0,
          "min": 0.0,
          "required": true,
          "type": "number"
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "encoder:pcm_s16le"
      ],
      "tool": "ffmpeg-skill/cut",
      "type": "TRIM"
    },
    {
      "description": "Remove explicit source time ranges; the remainder is joined in order",
      "deterministic": "content_equivalent",
      "inputs": {
        "max": 1,
        "min": 1
      },
      "keeps_timeline": false,
      "parameters": {
        "remove": {
          "description": "ranges to remove, sorted, non-overlapping",
          "items": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "type": "number"
              },
              "start": {
                "type": "number"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "type": "object"
          },
          "required": true,
          "type": "array"
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "encoder:pcm_s16le"
      ],
      "tool": "ffmpeg-skill/cut",
      "type": "CUT"
    },
    {
      "description": "Remove explicit silence ranges (decided by the caller) with margin and minimum duration rules",
      "deterministic": "content_equivalent",
      "inputs": {
        "max": 1,
        "min": 1
      },
      "keeps_timeline": false,
      "parameters": {
        "margin": {
          "default": 0.0,
          "description": "seconds of the range kept on each side (the removed part shrinks by margin at both ends)",
          "max": 10.0,
          "min": 0.0,
          "required": false,
          "type": "number"
        },
        "min_duration": {
          "default": 0.0,
          "description": "ranges shorter than this (after margin) are not removed",
          "max": 86400.0,
          "min": 0.0,
          "required": false,
          "type": "number"
        },
        "ranges": {
          "description": "silence ranges to remove, sorted, non-overlapping (as observed by the caller, e.g. media-analysis-skill)",
          "items": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "type": "number"
              },
              "start": {
                "type": "number"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "type": "object"
          },
          "required": true,
          "type": "array"
        },
        "threshold_db": {
          "description": "threshold the caller used to find the ranges; recorded in provenance, not applied",
          "max": 0.0,
          "min": -120.0,
          "required": false,
          "type": "number"
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "encoder:pcm_s16le"
      ],
      "tool": "ffmpeg-skill/cut",
      "type": "SILENCE_REMOVE"
    },
    {
      "description": "Linear fade in from the start",
      "deterministic": "content_equivalent",
      "inputs": {
        "max": 1,
        "min": 1
      },
      "keeps_timeline": true,
      "parameters": {
        "duration": {
          "description": "seconds",
          "max": 3600.0,
          "min": 0.001,
          "required": true,
          "type": "number"
