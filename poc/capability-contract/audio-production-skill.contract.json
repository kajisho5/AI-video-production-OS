        "ffprobe",
        "encoder:pcm_s16le",
        "filter:afade"
      ],
      "tool": "ffmpeg-skill/audio",
      "type": "FADE_OUT"
    },
    {
      "description": "Two-pass EBU R128 loudness normalisation (ffmpeg loudnorm, linear mode)",
      "deterministic": "content_equivalent",
      "inputs": {
        "max": 1,
        "min": 1
      },
      "keeps_timeline": true,
      "parameters": {
        "loudness_range_lu": {
          "description": "loudness range target in LU (omit: ffmpeg-skill default 11)",
