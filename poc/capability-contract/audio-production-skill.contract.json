      "keeps_timeline": true,
      "parameters": {
        "duration": {
          "description": "seconds",
          "max": 3600.0,
          "min": 0.001,
          "required": true,
          "type": "number"
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
