{
  "analysis_kinds": [
    "media_probe",
    "stream_layout",
    "video_format",
    "audio_format",
    "duration",
    "silence",
    "loudness",
    "integrity",
    "scene_detection",
    "timing"
  ],
  "budget": {
    "exceeded": "BUDGET_EXCEEDED, no observation, no analyzer process",
    "supported": [
      "max_analysis_calls",
      "timeout",
      "max_total_seconds"
    ],
    "unknown_fields": "INVALID_INPUT"
  },
  "cache": {
    "hit_runs_analyzer": false,
    "key": [
      "asset_fingerprint(sha256 of content)",
      "analyzer",
      "analyzer_version",
      "kind",
      "effective_parameters(canonical JSON)"
    ],
    "policies": [
      "use",
      "bypass",
      "only"
    ],
    "statuses": [
      "hit",
      "miss",
      "invalid",
      "bypass",
      "disabled"
    ]
  },
  "capabilities": [
    "ffprobe"
  ],
  "capability_names": [
    "ffmpeg",
    "ffprobe",
    "filter:ebur128",
    "filter:scdet",
    "filter:silencedetect"
  ],
  "description": "Deterministic media observation / analysis. Measures facts about media files; never interprets, decides or edits.",
  "errors": {
    "codes": [
      "INVALID_INPUT",
      "FILE_NOT_FOUND",
      "PATH_NOT_ALLOWED",
      "UNSUPPORTED_FORMAT",
      "ANALYZER_UNAVAILABLE",
      "ANALYZER_TIMEOUT",
      "ANALYSIS_FAILED",
      "INVALID_RESULT",
      "BUDGET_EXCEEDED",
      "CACHE_INVALID",
      "VERIFICATION_FAILED",
      "CACHE_MISS"
    ],
    "exit_codes": {
      "ANALYSIS_FAILED": 8,
      "ANALYZER_TIMEOUT": 7,
      "ANALYZER_UNAVAILABLE": 6,
      "BUDGET_EXCEEDED": 10,
      "CACHE_INVALID": 11,
      "CACHE_MISS": 13,
      "FILE_NOT_FOUND": 3,
      "INVALID_INPUT": 2,
      "INVALID_RESULT": 9,
      "PATH_NOT_ALLOWED": 4,
      "UNSUPPORTED_FORMAT": 5,
      "VERIFICATION_FAILED": 12
    },
    "success_exit_code": 0
  },
  "execution": {
    "ai": false,
    "canonical_invocation": [
      "media-analysis",
      "run",
      "<request.json | ->",
      "--json"
    ],
    "executable_resolution": "PATH lookup only; not configurable through the request or the CLI",
    "executables": [
      "ffprobe",
      "ffmpeg"
    ],
    "media_processing": false,
    "mode": "local_subprocess",
    "network": false,
    "stderr": "diagnostics only; never part of the contract",
    "stdin": "AnalysisRequest JSON when the request argument is '-'",
    "stdout": "exactly one response document (response schema) when --json is given"
  },
  "identity": {
    "analysis_identity": [
      "asset_fingerprint",
      "analyzer",
      "analyzer_version",
      "kind",
      "effective_parameters"
    ],
    "canonical_json": true,
    "derived_analysis_id": "analysis-<identity[:16]>",
    "observation_id": "obs_<identity[:16]>"
  },
  "kind_to_tool": {
    "audio_format": "media-analysis/audio",
    "duration": "media-analysis/timing",
    "integrity": "media-analysis/integrity",
    "loudness": "media-analysis/loudness",
