{
  "name": "@ecosystem-dashboard/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ecosystem Dashboard UI: a read-only, mobile-first, PWA-ready static view over one aggregator-generated EcosystemSnapshot JSON. Never calls GitHub directly, never holds a token (docs/adr/ADR-011-ecosystem-dashboard.md).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
