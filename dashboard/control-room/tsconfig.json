{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "paths": {
      "@ecosystem/types": ["../shared/types.ts"]
    }
  },
  "include": ["src", "test", "../shared/types.ts"]
}
